<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/largeWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_card"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Logo"
            android:src="@drawable/ic_launcher_foreground" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Kalanım"
            android:textColor="#1565C0"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/largeRefreshBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_bg_btn"
            android:paddingHorizontal="14dp"
            android:paddingVertical="7dp"
            android:text="Sorgula &amp; Dinle"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main 3 Stats: Bakiye, Gün, Dakika -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <!-- Bakiye -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_stat_box"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BAKİYE"
                android:textColor="#78909C"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/largeBalanceText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="-- TL"
                android:textColor="#1A237E"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Kalan Gün -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_stat_box"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KALAN GÜN"
                android:textColor="#78909C"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/largeDaysText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="-- gün"
                android:textColor="#E65100"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Kalan Dakika -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_stat_box"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DAKİKA"
                android:textColor="#78909C"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/largeMinutesText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="-- DK"
                android:textColor="#2E7D32"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Sub Stats: İnternet & SMS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <!-- Internet -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_stat_box"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="İnternet: "
                android:textColor="#78909C"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/largeInternetText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-- GB"
                android:textColor="#0277BD"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- SMS -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_stat_box"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SMS: "
                android:textColor="#78909C"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/largeSmsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-- SMS"
                android:textColor="#4527A0"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Footer -->
    <TextView
        android:id="@+id/largeFooterText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="Son güncelleme bilgisi bekleniyor"
        android:textColor="#90A4AE"
        android:textSize="11sp" />
</LinearLayout>

